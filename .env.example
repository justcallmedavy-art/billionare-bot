# ============================================================
# Billinare Deal Option — Environment Variable Template
# Copy to .env and fill in. NEVER commit real secrets.
# ============================================================

# --- Core ---
DATABASE_URL="postgresql://user:password@host:5432/billinare?schema=public"
# For local dev with SQLite: file:./dev.db
SESSION_SECRET="generate-with: openssl rand -hex 32"
# 64 hex chars (32 bytes) — AES key for encrypting provider tokens at rest.
# Falls back to a key derived from SESSION_SECRET when empty.
ENCRYPTION_KEY=""
NEXT_PUBLIC_APP_NAME="Billinare Deal Option"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEMO_STARTING_BALANCE="10000"

# --- Provider adapters (leave empty to run in SIMULATED mode) ---
# When empty, market data is a clearly-labeled simulated feed and
# real-money trading remains disabled. No real provider is faked.
MARKET_DATA_PROVIDER="simulated"          # simulated | deriv | broker-adapter
BROKER_PROVIDER="none"                    # none | deriv | mt5-bridge | custom
BROKER_API_URL=""
BROKER_API_KEY=""
BROKER_API_SECRET=""
BROKER_ACCOUNT_ID=""

# --- Deriv OAuth (https://api.deriv.com) ---
# Register an app at api.deriv.com to get an App ID. The authorization
# redirect must be exactly NEXT_PUBLIC_APP_URL + /api/auth/deriv/callback.
DERIV_APP_ID=""
NEXT_PUBLIC_DERIV_APP_ID=""

# --- Payments (leave empty => deposit/withdrawal stays in PENDING verification) ---
PAYMENT_PROVIDER="none"                   # none | stripe | manual-verification
PAYMENT_WEBHOOK_SECRET=""
PAYMENT_API_KEY=""

# --- Email (verification / security alerts) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="no-reply@billinare.example"

# --- Ops ---
ADMIN_BOOTSTRAP_EMAIL="admin@billinare.local"
LOG_LEVEL="info"
